# 로컬 실행용 환경 변수 템플릿. `cp .env.example .env` 후 값을 채운다.
# local 프로필은 이 파일이 아닌 .env 를 읽는다. .env 는 커밋하지 않는다.
# 주석 처리된 항목은 local 프로필에 기본값이 있어 생략할 수 있다.

# DB (local 프로필에도 기본값이 없어 반드시 채운다)
# DB_URL=jdbc:mysql://localhost:3306/vehicle_db
DB_USERNAME=
DB_PASSWORD=

# Origin (S3 호환 SeaweedFS)
# ORIGIN_ENDPOINT=http://localhost:8333
# ORIGIN_REGION=us-east-1
# ORIGIN_BUCKET=orbit-firmware
# ORIGIN_ACCESS_KEY=local-access-key
# ORIGIN_SECRET_KEY=local-secret-key

# 인증
# ENROLLMENT_KEY=local-enrollment-key
# ADMIN_TOKEN=local-admin-token

# 매니페스트 다운로드 URL 의 앞부분
# CDN_BASE_URL=http://localhost:8080

# CDN Edge 선택
# CDN_FALLBACK_COUNT=2
# CDN_LOCATION_MAX_AGE=10m
# Edge 목록(default-edge-id, edges)은 중첩 리스트라 이 파일로 넣지 않는다. local 프로필에는 임시 목록이 있다.
# 다른 목록이 필요하면 YAML 파일을 만들어 실행 인자로 준다. 이 파일에 적으면 적용되지 않고,
# SPRING_CONFIG_IMPORT 환경 변수는 local 프로필의 .env 가져오기를 덮어쓰므로 쓰지 않는다.
#   ./gradlew bootRun --args='--spring.config.additional-location=file:./application-cdn.yml'

# CDN Edge 헬스체크 (로컬에 Edge 가 없으면 Edge 가 모두 비정상으로 바뀐다)
# CDN_HEALTH_CHECK_INTERVAL=10s
# CDN_HEALTH_CHECK_FAILURE_THRESHOLD=3
# CDN_HEALTH_CHECK_TIMEOUT=2s

# 주기 조정 (데모처럼 빠른 반응이 필요할 때)
# CHECK_IN_INTERVAL_SECONDS=30
# DASHBOARD_STREAM_POLL_INTERVAL=1s
# DASHBOARD_STREAM_KEEP_ALIVE_INTERVAL=15s
# 5초보다 짧으면 앱이 뜨지 않는다
# DASHBOARD_STREAM_OVERLAP=10s
